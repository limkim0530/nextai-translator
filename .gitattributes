# Normalize line endings across platforms.
# Repo stores text as LF; Git converts on checkout per rules below.
# Git decides text vs binary by content, and every text file is checked out with LF
# no matter what `core.autocrlf` says. Prettier's `endOfLine` defaults to "lf", so
# without this a Windows checkout reports a `Delete ␍` error on every line of every
# file and buries the real lint output.

# Default: treat as text, store LF in the repo, check out LF.
* text=auto eol=lf

# Windows-only scripts must stay CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch line endings.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.icns   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.dll    binary
*.exe    binary
*.so     binary
*.dylib  binary
*.node   binary

